{
  "name": "tool-loop-guard",
  "version": "1.0.0",
  "description": "Pi extension: sliding-window and KMP minimal-period detection that prevents tool-call loops.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZouZhao321/tool-loop-guard.git"
  },
  "homepage": "https://github.com/ZouZhao321/tool-loop-guard#readme",
  "bugs": {
    "url": "https://github.com/ZouZhao321/tool-loop-guard/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "agent",
    "loop-detection"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/smoke.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run format:check && npm run check:pack"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
